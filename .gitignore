# Lesson videos are too big for GitHub (2+ GB, some files over 100 MB); keep them on the PC / a drive.
frontend/videos/**/*.mp4
frontend/videos/**/*.mov
# local tool output
frontend/tools/__pycache__/
.claude/
node_modules/
.vite/
dist/
tmp/
.env
.env.*
!.env.example
backend/.local/
# Keep the publisher's original large PDF locally; generated reader pages are tracked.
frontend/books/steamford-urdu 4+/*.pdf
frontend/books/stemford-english-4+/*.pdf

frontend/books/stemford-math-4/*.pdf
frontend/books/stemford english 5+/*.pdf
frontend/books/stemford urdu 5+/*.pdf
frontend/books/stemford math 5+/*.pdf
frontend/books/class 1/*.pdf
