{
  "name": "book-activity-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:local:init": "node scripts/local-postgres.js init",
    "db:start": "node scripts/local-postgres.js start",
    "db:stop": "node scripts/local-postgres.js stop",
    "db:setup": "node scripts/setup-database.js",
    "db:migrate": "node scripts/migrate.js",
    "db:check": "node scripts/check-database.js",
    "test:db": "node --test --test-concurrency=1 tests/database.test.js tests/auth.test.js tests/portal-store.test.js tests/school-access.test.js tests/learning.test.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jszip": "^3.10.1",
    "pg": "^8.23.1"
  }
}
