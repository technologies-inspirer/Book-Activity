# Copy to /srv/book-activity/.env. Never commit the real file.
APP_IMAGE=ghcr.io/technologies-inspirer/book-activity:REPLACE_WITH_COMMIT_SHA
SITE_HOST=books.example.com
POSTGRES_DB=book_activity
# Use `openssl rand -hex 32` so it is safe inside a PostgreSQL URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_HEX_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_APP_HEX_PASSWORD
VIDEOS_PATH=/srv/book-activity/videos
